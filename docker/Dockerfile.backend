# PhishGuard AI — Backend
FROM python:3.12-slim

# System dependencies for dnspython, bcrypt, scikit-learn
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy project files
COPY backend/           ./backend/
COPY data/saved_models/ ./data/saved_models/
COPY data/incidents.json ./data/incidents.json

# Create data directories
RUN mkdir -p data/processed data/evaluation

# Expose FastAPI port
EXPOSE 8000

# Start the API
CMD ["python", "-m", "uvicorn", "backend.main:app", \
     "--host", "0.0.0.0", "--port", "8000"]
