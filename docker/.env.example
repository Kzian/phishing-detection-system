# PhishGuard AI — Environment Variables
# Copy this file to .env and update values

# JWT secret key — change this in production
SECRET_KEY=phishguard-change-this-secret-in-production

# n8n webhook URL for incident notifications
N8N_WEBHOOK_URL=http://n8n:5678/webhook/phishguard

# AgentMail webhook secret (optional)
AGENTMAIL_SECRET=
